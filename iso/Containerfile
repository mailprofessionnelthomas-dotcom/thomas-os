# Image « installateur » de Thomas OS : ce qui tourne sur la clé USB (session live + installateur).
# Construite sur GitHub (workflow iso.yml), jamais sur un PC. Méthode de Bazzite (dossier installer/ du dépôt
# ublue-os/bazzite, tiré de ondrejbudai/bootc-isos), puis l'ISO est fabriquée par ublue-os/titanoboa.
# Construire avec : podman build --cap-add sys_admin --security-opt label=disable
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
RUN --mount=type=bind,source=./,target=/src \
    env BASE_IMAGE="${BASE_IMAGE}" INSTALL_IMAGE_PAYLOAD="${INSTALL_IMAGE_PAYLOAD}" /src/build.sh
