#!/usr/bin/python3
"""Installateur Thomas OS : double-clic sur un fichier téléchargé, comme sur Windows.

  thomas-installateur FICHIER            ce que fait le double-clic (fenêtres kdialog)
  thomas-installateur --oui FICHIER      pareil, en répondant oui à tout et sans rien ouvrir après (tests)
  thomas-installateur --choix FICHIER…   décision seule, en JSON, sans rien installer (tests)
  thomas-installateur --lancer EXE       lance un programme Windows installé (raccourcis du menu)
  thomas-installateur --verifier         auto-test (build de l'image, sans Internet)

Selon le fichier :
  - appli connue (Steam, Epic Games → Heroic, Discord…) ou trouvée dans la boutique (Flathub) : la version boutique est
    installée (même appli, mises à jour automatiques) ; Thomas OS n'installe pas les paquets .deb/.rpm (système protégé) ;
  - .exe / .msi : lancé avec Proton (umu-run, dans l'image) dans un « Windows » commun (~/.local/share/thomas-os/windows) ;
    les raccourcis du menu Démarrer créés par l'installateur Windows deviennent des raccourcis du menu Thomas OS ;
  - .AppImage : rangé dans ~/Applications et ajouté au menu.
Journal : ~/.cache/thomas-os/installateur.log
"""
import contextlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

TITRE = "Installateur Thomas OS"
HEROIC = "com.heroicgameslauncher.hgl"
MAISON = Path.home()
PREFIXE = MAISON / ".local/share/thomas-os/windows"
APPLIS = MAISON / ".local/share/applications"
CACHE = MAISON / ".cache/thomas-os"
JOURNAL = CACHE / "installateur.log"
EXTENSIONS = (".tar.gz", ".tar.xz", ".tar.zst", ".tar.bz2", ".tgz", ".appimage", ".exe", ".msi", ".deb", ".rpm")

# (motif cherché dans le nom du fichier, id Flathub ou None, nom affiché, explication). Ordre important : le 1er qui
# correspond gagne (Obsidian avant OBS, Roblox Studio avant Roblox).
