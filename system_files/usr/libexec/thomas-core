#!/usr/bin/python3
"""Thomas Core : service D-Bus de session « org.thomasos.Core » (voir docs/ARCHITECTURE.md §3).

Lancé à la demande par D-Bus, il s'arrête tout seul après 60 s sans appel : il ne coûte rien au repos.
Interfaces v1 : org.thomasos.Systeme1 (infos, carte graphique), org.thomasos.Style1 (styles),
org.thomasos.Diagnostic1 (rapport). Les applis Thomas OS passent par lui, jamais directement par KDE.
Transition : le moteur de styles reste /usr/bin/thomas-style, chargé ici comme bibliothèque.
"""
import configparser
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import statistics
import subprocess
import sys
import time
import urllib.request
from pathlib import Path

from gi.repository import Gio, GLib

sys.path.insert(0, os.environ.get("THOMAS_PYTHON", "/usr/lib/thomas-os/python"))
from thomas_os import capteurs  # noqa: E402

NOM, CHEMIN = "org.thomasos.Core", "/org/thomasos/Core"
INACTIF_S = int(os.environ.get("THOMAS_CORE_INACTIF", "60"))


def charger_module(nom, chemin):
    """Charge un script Python sans extension .py comme module (load_module n'existe plus en Python 3.14)."""
    chargeur = importlib.machinery.SourceFileLoader(nom, chemin)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(nom, chargeur))
    chargeur.exec_module(module)
    return module


STYLE = charger_module("thomas_style", os.environ.get("THOMAS_STYLE_BIN", "/usr/bin/thomas-style"))
INFO_ENV = Path("/usr/share/thomas-os/info.env")
FABRICANTS = {"0x10de": "nvidia", "0x1002": "amd", "0x8086": "intel"}

XML = """<node>
  <interface name="org.thomasos.Systeme1">
    <method name="Infos"><arg type="a{ss}" direction="out"/></method>
    <method name="CarteGraphique"><arg type="a{ss}" direction="out"/></method>
    <method name="Reseau"><arg type="a{ss}" direction="out"/></method>
    <method name="Energie"><arg type="a{ss}" direction="out"/></method>
    <method name="ChoisirEnergie"><arg name="profil" type="s" direction="in"/></method>
  </interface>
  <interface name="org.thomasos.Config1">
    <method name="Lire"><arg name="section" type="s" direction="in"/><arg name="cle" type="s" direction="in"/>
      <arg type="s" direction="out"/></method>
    <method name="Ecrire"><arg name="section" type="s" direction="in"/><arg name="cle" type="s" direction="in"/>
      <arg name="valeur" type="s" direction="in"/></method>
    <signal name="ConfigChange"><arg name="section" type="s"/><arg name="cle" type="s"/></signal>
  </interface>
  <interface name="org.thomasos.Style1">
    <method name="Liste"><arg type="a(ss)" direction="out"/></method>
    <method name="Actuel"><arg type="s" direction="out"/></method>
    <method name="Appliquer"><arg name="id" type="s" direction="in"/><arg name="disposition" type="s" direction="in"/></method>
    <method name="Secours"/>
    <method name="Annuler"/>
    <method name="PeutAnnuler"><arg type="b" direction="out"/></method>
    <method name="Catalogue"><arg type="s" direction="out"/></method>
    <method name="Lire"><arg name="id" type="s" direction="in"/><arg type="s" direction="out"/></method>
    <method name="Enregistrer"><arg name="id" type="s" direction="in"/><arg name="reglages" type="s" direction="in"/>
      <arg name="id_final" type="s" direction="out"/><arg name="corrections" type="as" direction="out"/></method>
    <method name="Importer"><arg name="chemin" type="s" direction="in"/>
      <arg name="id" type="s" direction="out"/><arg name="corrections" type="as" direction="out"/></method>
    <method name="Exporter"><arg name="id" type="s" direction="in"/><arg name="chemin" type="s" direction="in"/></method>
    <method name="Supprimer"><arg name="id" type="s" direction="in"/></method>
    <signal name="StyleChange"><arg name="id" type="s"/></signal>
    <signal name="ListeChange"/>
  </interface>
  <interface name="org.thomasos.Diagnostic1">
    <method name="Rapport"><arg type="s" direction="out"/></method>
    <method name="Temperatures"><arg type="a(sdd)" direction="out"/></method>
    <method name="TestReseau"><arg type="a{ss}" direction="out"/></method>
    <method name="TestDebit"><arg type="a{ss}" direction="out"/></method>
    <method name="Nettoyage"><arg type="a{ss}" direction="out"/></method>
  </interface>
</node>"""


def lire_env():
    infos = {}
    if INFO_ENV.exists():
        for ligne in INFO_ENV.read_text(encoding="utf-8").splitlines():
            if "=" in ligne:
                k, v = ligne.split("=", 1)
                infos[k.replace("THOMAS_OS_", "").lower()] = v
    return infos


def commande(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def infos():
    i = lire_env()
    i.setdefault("version", "?")
    try:  # canal suivi par les mises à jour (rpm-ostree répond sans être root)
        st = json.loads(commande("rpm-ostree", "status", "--json", "--booted") or "{}")
        ref = st.get("deployments", [{}])[0].get("container-image-reference", "")
        i["image_suivie"] = ref.split(":", 1)[-1] if ref else "?"
        i["canal"] = ref.rsplit(":", 1)[-1] if ":" in ref else "?"
    except (ValueError, IndexError):
        i["canal"] = "?"
    return i


def carte_graphique():
    """Carte(s) détectée(s) et variante installée : l'écran de bienvenue en déduit s'il faut changer."""
    trouves = []
    for v in Path("/sys/class/drm").glob("card[0-9]*/device/vendor"):
        f = FABRICANTS.get(v.read_text().strip())
        if f and f not in trouves:
            trouves.append(f)
    variante = lire_env().get("gpu_variant", "?")
    nvidia = "nvidia" in trouves
    conforme = (variante.startswith("nvidia") and nvidia) or (variante == "amd-intel" and not nvidia)
    conseil = "" if conforme else ("thomas-os-nvidia (ou -nvidia-legacy pour GTX 900/1000)" if nvidia else "thomas-os")
    return {"detectees": ",".join(trouves) or "inconnue", "variante": variante,
            "conforme": "oui" if conforme else "non", "conseil": conseil}


def reseau():
    """Connexion en cours (pour l'écran de bienvenue) : etat = connecte / deconnecte / inconnu."""
    try:
        sortie = subprocess.run(["nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device"], capture_output=True, text=True,
                                timeout=10, env={**os.environ, "LC_ALL": "C"}).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {"etat": "inconnu", "type": "", "nom": ""}
    for ligne in sortie.splitlines():
        champs = [c.replace("\x00", ":") for c in ligne.replace("\\:", "\x00").split(":")]
        if len(champs) >= 3 and champs[1] == "connected" and champs[0] in ("wifi", "ethernet"):
            return {"etat": "connecte", "type": champs[0], "nom": champs[2]}
    return {"etat": "deconnecte", "type": "", "nom": ""}


# ---------- énergie (tuned-ppd ou power-profiles-daemon : même interface D-Bus) ----------
ENERGIE = [("org.freedesktop.UPower.PowerProfiles", "/org/freedesktop/UPower/PowerProfiles"),
           ("net.hadess.PowerProfiles", "/net/hadess/PowerProfiles")]


def _energie_prop(bus, nom, chemin, prop):
    r = bus.call_sync(nom, chemin, "org.freedesktop.DBus.Properties", "Get", GLib.Variant("(ss)", (nom, prop)),
                      None, Gio.DBusCallFlags.NONE, 3000, None)
    return r.unpack()[0]


def energie():
    """Profil d'énergie actuel, profils possibles, et si le mode jeu le maintient en ce moment."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    except GLib.Error:
        return {"profil": "", "profils": "", "jeu": "non", "service": ""}
    for nom, chemin in ENERGIE:
        try:
            actif = _energie_prop(bus, nom, chemin, "ActiveProfile")
            profils = [p["Profile"] for p in _energie_prop(bus, nom, chemin, "Profiles")]
            maintiens = _energie_prop(bus, nom, chemin, "ActiveProfileHolds")
        except GLib.Error:
            continue
        jeu = any(m.get("ApplicationId") == "org.thomasos.jeu" for m in maintiens)
        return {"profil": actif, "profils": ",".join(profils), "jeu": "oui" if jeu else "non", "service": nom}
    return {"profil": "", "profils": "", "jeu": "non", "service": ""}


def choisir_energie(profil):
    if profil not in ("power-saver", "balanced", "performance"):
        raise STYLE.Erreur(f"profil d'énergie inconnu : {profil}")
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    dernier = "service d'énergie absent"
    for nom, chemin in ENERGIE:
        try:
            bus.call_sync(nom, chemin, "org.freedesktop.DBus.Properties", "Set",
                          GLib.Variant("(ssv)", (nom, "ActiveProfile", GLib.Variant("s", profil))), None,
                          Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 30000, None)
            return
        except GLib.Error as e:
            dernier = e.message
    raise STYLE.Erreur(f"profil d'énergie non changé : {dernier}")


# ---------- diagnostic réseau : mesurer, ne rien régler (vision : aucun réglage réseau « universel ») ----------
def test_reseau():
    """Latence (8 connexions TCP vers 1.1.1.1:443 : marche même là où le ping est bloqué), DNS, signal Wi-Fi."""
    r = dict(reseau())
    temps, echecs = [], 0
    for _ in range(8):
        t0 = time.perf_counter()
        try:
            with socket.create_connection(("1.1.1.1", 443), timeout=2):
                temps.append((time.perf_counter() - t0) * 1000)
        except OSError:
            echecs += 1
        time.sleep(0.1)
    if temps:
        r.update(latence_ms=f"{statistics.median(temps):.0f}", latence_min=f"{min(temps):.0f}",
                 latence_max=f"{max(temps):.0f}", gigue_ms=f"{statistics.pstdev(temps):.0f}")
    r["pertes"] = f"{echecs}/8"
    t0 = time.perf_counter()
    try:
        socket.getaddrinfo("github.com", 443)
        r["dns_ms"] = f"{(time.perf_counter() - t0) * 1000:.0f}"
    except OSError:
        r["dns_ms"] = "échec"
    if r.get("type") == "wifi":
        for ligne in commande("nmcli", "-t", "-f", "IN-USE,SIGNAL", "device", "wifi").splitlines():
            if ligne.startswith("*:"):
                r["signal"] = ligne.split(":")[1]
    return r


def test_debit():
    """Débit descendant : télécharge 25 Mo (arrêt au bout de 15 s) depuis le serveur de test de Cloudflare."""
    url = "https://speed.cloudflare.com/__down?bytes=25000000"
    t0, n = time.perf_counter(), 0
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "ThomasOS-diagnostic"}),
                                    timeout=20) as rep:
            while time.perf_counter() - t0 < 15:
                bloc = rep.read(1 << 16)
                if not bloc:
                    break
                n += len(bloc)
    except OSError as e:
        raise STYLE.Erreur(f"débit non mesuré : {e}") from e
    dt = max(time.perf_counter() - t0, 0.001)
    return {"debit_mbps": f"{n * 8 / dt / 1e6:.0f}", "mo": f"{n / 1e6:.0f}", "secondes": f"{dt:.1f}",
            "source": "speed.cloudflare.com"}


def nettoyage():
    """Dernier nettoyage automatique (écrit par thomas-nettoyage, en root)."""
    try:
        d = json.loads(Path("/var/lib/thomas-os/nettoyage.json").read_text(encoding="utf-8"))
        return {"date": str(d.get("date", "")), "libere_mo": str(d.get("libere_mo", ""))}
    except (OSError, ValueError):
        return {"date": "", "libere_mo": ""}


CONFIG = STYLE.CFG / "thomas.conf"  # préférences générales (docs/ARCHITECTURE.md §4.2)
NOM_CONFIG = re.compile(r"[a-z][a-z0-9_]{0,39}")


def config_lire(section, cle):
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(CONFIG, encoding="utf-8")
    return cp.get(section, cle, fallback="")


def config_ecrire(section, cle, valeur):
    if not (NOM_CONFIG.fullmatch(section) and NOM_CONFIG.fullmatch(cle)) or "\n" in valeur:
        raise STYLE.Erreur(f"réglage invalide : {section}.{cle}")
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(CONFIG, encoding="utf-8")
    if not cp.has_section(section):
        cp.add_section(section)
    cp[section][cle] = valeur
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_suffix(".tmp")
    with tmp.open("w", encoding="utf-8") as fic:
        fic.write("# Préférences de Thomas OS (écrites par Thomas Core)\n")
        cp.write(fic)
    tmp.replace(CONFIG)


def rapport():
    lignes = [f"Thomas OS {lire_env().get('version', '?')}"]
    for nom, cmd in (("système", ["systemctl", "--failed", "--no-legend", "--plain"]),
                     ("session", ["systemctl", "--user", "--failed", "--no-legend", "--plain"])):
        echecs = [l.split()[0] for l in commande(*cmd).splitlines() if l.strip()]
        lignes.append(f"Services en échec ({nom}) : {', '.join(echecs) if echecs else 'aucun'}")
    for point, total, libre in capteurs.disques():
        lignes.append(f"Disque {point} : {(total - libre) * 100 // max(total, 1)} % utilisé, {libre // 2**30} Go libres")
    temps = capteurs.temperatures()
    lignes += [f"Température {nom} : {v:.0f} °C" for nom, v, _ in temps] or ["Températures : capteurs non disponibles"]
    return "\n".join(lignes)


class Service:
    def __init__(self):
        self.boucle = GLib.MainLoop()
        self.minuterie = None
        self.connexion = None
        self.rearmer()

    def rearmer(self):
        if self.minuterie:
            GLib.source_remove(self.minuterie)
        self.minuterie = GLib.timeout_add_seconds(INACTIF_S, self.boucle.quit)

    def style(self, *args):
        """Lance « thomas-style ARGS » sans bloquer le service ; StyleChange part quand c'est fini."""
        pid, *_ = GLib.spawn_async([os.environ.get("THOMAS_STYLE_BIN", "/usr/bin/thomas-style"), *args],
                                   flags=GLib.SpawnFlags.DO_NOT_REAP_CHILD)
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, pid, lambda *_: self.signaler())

    def signaler(self):
        self.rearmer()
        self.connexion.emit_signal(None, CHEMIN, "org.thomasos.Style1", "StyleChange",
                                   GLib.Variant("(s)", (STYLE.actuel_id(),)))

    def liste_change(self):
        self.connexion.emit_signal(None, CHEMIN, "org.thomasos.Style1", "ListeChange", None)

    def appel(self, conn, expediteur, chemin, interface, methode, params, invocation):
        self.rearmer()
        try:
            if interface == "org.thomasos.Config1":  # mêmes noms de méthodes que Style1 : on regarde l'interface d'abord
                if methode == "Lire":
                    rep = GLib.Variant("(s)", (config_lire(*params.unpack()),))
                elif methode == "Ecrire":
                    section, cle, valeur = params.unpack()
                    config_ecrire(section, cle, valeur)
                    conn.emit_signal(None, CHEMIN, interface, "ConfigChange", GLib.Variant("(ss)", (section, cle)))
                    rep = None
                else:
                    raise STYLE.Erreur(f"méthode inconnue : {methode}")
            elif methode == "Reseau":
                rep = GLib.Variant("(a{ss})", (reseau(),))
            elif methode == "Energie":
                rep = GLib.Variant("(a{ss})", (energie(),))
            elif methode == "ChoisirEnergie":
                choisir_energie(params.unpack()[0])
                rep = None
            elif methode == "Temperatures":
                rep = GLib.Variant("(a(sdd))", ([(n, float(v), float(l)) for n, v, l in capteurs.temperatures()],))
            elif methode == "TestReseau":
                rep = GLib.Variant("(a{ss})", (test_reseau(),))
            elif methode == "TestDebit":
                rep = GLib.Variant("(a{ss})", (test_debit(),))
            elif methode == "Nettoyage":
                rep = GLib.Variant("(a{ss})", (nettoyage(),))
            elif methode == "Infos":
                rep = GLib.Variant("(a{ss})", (infos(),))
            elif methode == "CarteGraphique":
                rep = GLib.Variant("(a{ss})", (carte_graphique(),))
            elif methode == "Liste":
                rep = GLib.Variant("(a(ss))", (STYLE.lister(),))
            elif methode == "Actuel":
                rep = GLib.Variant("(s)", (STYLE.actuel_id(),))
            elif methode == "Appliquer":
                sid, dispo = params.unpack()
                STYLE.charger(sid)  # refuse tout de suite un style inconnu ou mal écrit
                if dispo and dispo not in STYLE.DISPOS:
                    raise STYLE.Erreur(f"disposition inconnue : {dispo}")
                self.style("appliquer", sid, *([dispo] if dispo else []))
                rep = None
            elif methode == "Secours":
                self.style("appliquer", STYLE.DEFAUT)
                rep = None
            elif methode == "Annuler":
                if not STYLE.historique():
                    raise STYLE.Erreur("Rien à annuler : aucun style précédent n'est gardé")
                self.style("annuler")
                rep = None
            elif methode == "PeutAnnuler":
                rep = GLib.Variant("(b)", (bool(STYLE.historique()),))
            elif methode == "Catalogue":
                rep = GLib.Variant("(s)", (json.dumps(STYLE.catalogue(), ensure_ascii=False),))
            elif methode == "Lire":
                rep = GLib.Variant("(s)", (json.dumps(STYLE.lire_style(params.unpack()[0]), ensure_ascii=False),))
            elif methode == "Enregistrer":
                sid, texte = params.unpack()
                rep = GLib.Variant("(sas)", STYLE.enregistrer(sid, json.loads(texte)))
                self.liste_change()
            elif methode == "Importer":
                rep = GLib.Variant("(sas)", STYLE.importer_fichier(params.unpack()[0]))
                self.liste_change()
            elif methode == "Exporter":
                STYLE.exporter(*params.unpack())
                rep = None
            elif methode == "Supprimer":
                STYLE.supprimer(params.unpack()[0])
                rep = None
                self.liste_change()
            elif methode == "Rapport":
                rep = GLib.Variant("(s)", (rapport(),))
            else:
                raise STYLE.Erreur(f"méthode inconnue : {methode}")
            invocation.return_value(rep)
        except (STYLE.Erreur, ValueError, OSError) as e:  # ValueError : réglages JSON mal écrits
            invocation.return_dbus_error("org.thomasos.Core.Erreur", str(e))
        except GLib.Error as e:  # un autre service (énergie…) n'a pas répondu
            invocation.return_dbus_error("org.thomasos.Core.Erreur", e.message)

    def lancer(self):
        noeud = Gio.DBusNodeInfo.new_for_xml(XML)

        def acquis(conn, nom):
            self.connexion = conn
            for i in noeud.interfaces:
                conn.register_object(CHEMIN, i, self.appel, None, None)

        Gio.bus_own_name(Gio.BusType.SESSION, NOM, Gio.BusNameOwnerFlags.NONE, acquis, None,
                         lambda *_: self.boucle.quit())
        self.boucle.run()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--test":  # sans D-Bus : affiche ce que le service répondrait
        print(json.dumps({"infos": infos(), "carte": carte_graphique(), "reseau": reseau(), "nettoyage": nettoyage(),
                          "temperatures": capteurs.temperatures()}, ensure_ascii=False, indent=1))
        config_ecrire("essai", "cle", "valeur")  # HOME jetable pendant le build
        assert config_lire("essai", "cle") == "valeur"
        print(rapport())
        json.dumps(STYLE.catalogue())  # ce que reçoit Thomas Studio
        print(f"Studio : {len(STYLE.lister())} styles, « {STYLE.DEFAUT} » = {STYLE.lire_style(STYLE.DEFAUT)['origine']}")
        sys.exit(0)
    Service().lancer()
