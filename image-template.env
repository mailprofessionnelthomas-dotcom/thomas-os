# Réglages de construction de Thomas OS (lus par le Justfile)

# Nom du repo GitHub (et nom de l'image principale AMD/Intel)
IMAGE_NAME=thomas-os

# Identifiant du compte GitHub propriétaire du repo
REPO_ORGANIZATION="mailprofessionnelthomas-dotcom"

# Image Bazzite de départ par défaut (la variante AMD/Intel)
BASE_IMAGE="ghcr.io/ublue-os/bazzite:stable"

IMAGE_DESC="Thomas OS : Linux base sur Bazzite (KDE Plasma, look Windows 11), installable depuis une cle USB live"
IMAGE_KEYWORDS="bootc,oci,linux,bazzite,gaming,kde"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="stable"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
